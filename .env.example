# Local development only. Copy to .env and change values outside local use.
NODE_ENV=development
LOG_LEVEL=info

DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=fvdms
DATABASE_USER=fvdms_app
DATABASE_PASSWORD=local-only-fvdms-app
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=2000

MIGRATION_DATABASE_USER=fvdms_migrator
MIGRATION_DATABASE_PASSWORD=local-only-fvdms-migrator

MYSQL_ADMIN_HOST=mysql
MYSQL_ADMIN_PORT=3306
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=

# Browser authentication policy. These values match the accepted FVD-002 defaults.
AUTH_ALLOWED_ORIGIN=https://fvdms.lan
AUTH_STANDARD_IDLE_TIMEOUT_SECONDS=1800
AUTH_PRIVILEGED_IDLE_TIMEOUT_SECONDS=900
AUTH_ABSOLUTE_TIMEOUT_SECONDS=28800
AUTH_PRIVILEGED_SESSION_LIMIT=1
AUTH_RATE_LIMIT_MAX_FAILURES=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_LOCK_SECONDS=900
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_ACTIVITY_WRITE_INTERVAL_SECONDS=300
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_TOTP_ACTIVE_KEY_VERSION=1
# Generate each key with: openssl rand -base64 32
# JSON object of versioned base64-encoded 32-byte AES keys. Replace outside local development.
AUTH_TOTP_ENCRYPTION_KEYS={"1":"replace-with-a-base64-encoded-32-byte-key"}
# Base64-encoded 32-byte HMAC key. Replace outside local development.
AUTH_RATE_LIMIT_HMAC_KEY=replace-with-a-base64-encoded-32-byte-key
